{
  "name": "@kiriminow/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Kirimi WhatsApp API",
  "type": "module",
  "main": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "import": "./dist/mod.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test \"tests/*_test.ts\"",
    "lint": "tsc --noEmit"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "kirimi",
    "whatsapp",
    "api",
    "sdk",
    "otp",
    "messaging"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kiriminow/kirimi-ts.git"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
