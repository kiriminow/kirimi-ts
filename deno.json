{
  "name": "@kiriminow/sdk",
  "version": "0.1.0",
  "license": "MIT",
  "exports": "./src/mod.ts",
  "publish": {
    "include": ["src/", "README.md", "LICENSE", "deno.json"],
    "exclude": ["**/*_test.ts", "tests/"]
  },
  "tasks": {
    "test": "deno test --allow-net tests/",
    "fmt": "deno fmt src/ tests/",
    "lint": "deno lint src/ tests/",
    "check": "deno check src/mod.ts"
  },
  "imports": {},
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true
  }
}
